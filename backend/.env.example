APP_NAME=Workforce Technology Assistant API
APP_VERSION=0.6.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workforce_assistant
POSTGRES_USER=workforce_user
POSTGRES_PASSWORD=workforce_password

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_CONNECTIONS=20

CONVERSATION_KEY_PREFIX=chat
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=40
SESSION_DEFAULT_TITLE=New conversation
SESSION_LIST_LIMIT=50

SEMANTIC_CACHE_KEY_PREFIX=semantic-cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_RESULTS=3
SEMANTIC_CACHE_MAX_ENTRIES_PER_SESSION=100

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_REQUEST_TIMEOUT=30
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192

AGENT_MAX_ITERATIONS=8
AGENT_DEBUG=false
MCP_SERVER_URL=http://mcp-server:8001/mcp